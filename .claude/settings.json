{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/evidence_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_check.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
